{
  "expo": {
    "name": "AkılCEP AI",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F7"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "AkılCEP AI, kameranızı AI Vizyon Modu için kullanmak istiyor.",
        "NSMicrophoneUsageDescription": "AkılCEP AI, ses kaydı ve sesli sohbet için mikrofonunuza erişmek istiyor."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-av",
      [
        "expo-camera",
        {
          "cameraPermission": "AkılCEP AI, AI Vizyon Modu için kameranıza erişmek istiyor.",
          "microphonePermission": "AkılCEP AI, ses kaydı için mikrofonunuza erişmek istiyor.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}