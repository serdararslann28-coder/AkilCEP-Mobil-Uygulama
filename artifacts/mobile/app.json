{
  "expo": {
    "name": "AkılCEP",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#F7F7F5",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "AkılCEP, kameranızı AI Vizyon Modu için kullanmak istiyor.",
        "NSMicrophoneUsageDescription": "AkılCEP, ses kaydı ve sesli sohbet için mikrofonunuza erişmek istiyor.",
        "NSPhotoLibraryAddUsageDescription": "AkılCEP, oluşturulan görselleri fotoğraf kütüphanenize kaydetmek istiyor.",
        "NSPhotoLibraryUsageDescription": "AkılCEP, oluşturulan görselleri fotoğraf kütüphanenize kaydetmek istiyor."
      },
      "bundleIdentifier": "com.akilcep.ai"
    },
    "android": {
      "package": "com.akilcep.ai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "AkılCEP, AI Vizyon Modu için kameranıza erişmek istiyor.",
          "microphonePermission": "AkılCEP, ses kaydı için mikrofonunuza erişmek istiyor.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F7F5"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "686fea1a-3531-4817-b8ee-de3f134d5322"
      }
    },
    "owner": "serdararslann28"
  },
}
